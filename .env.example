# Root admin user (bootstrap only: replica set init + app user creation, never used by app)
DB_ROOT_USERNAME=
DB_ROOT_PASSWORD=

# App-scoped user (readWrite on DB_NAME only)
DB_USERNAME=
DB_PASSWORD=

DB_URI=mongodb://${DB_USERNAME}:${DB_PASSWORD}@localhost:27017/${DB_NAME}?authSource=${DB_NAME}
DB_NAME=

# You can use `openssl rand -base64 32` to generate a secret key
BETTER_AUTH_SECRET=

# Most likely http://localhost:3000
BETTER_AUTH_URL=

# Most likely http://localhost:3000 because
# it's used for api endpoints which lives in the same server
VITE_PUBLIC_URL=
